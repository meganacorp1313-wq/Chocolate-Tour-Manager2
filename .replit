modules = ["nodejs-24", "python-base-3.13", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"

[userenv]

[userenv.shared]
WHOP_COMPANY_ID = "biz_awTYdEcefaQUr5"

[userenv.development]
FACTORY_EMAIL = "arbalanseu@gmail.com"
FROM_EMAIL = "Шоколадная фабрика <info@repdom.online>"

[userenv.production]
FACTORY_EMAIL = "arbalanseu@gmail.com"
FROM_EMAIL = "Шоколадная фабрика <info@repdom.online>"
